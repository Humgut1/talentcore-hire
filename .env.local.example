# ── Supabase 연결 정보 ──────────────────────────────────
# 이 파일을 복사해 .env.local 로 만든 뒤, 아래 3개 값을 채우세요.
#   Supabase 대시보드 → Project Settings → API 에서 확인할 수 있습니다.
#
# 값을 채우지 않아도 앱은 예시(샘플) 데이터로 정상 동작합니다.
# 값을 채우면 자동으로 실제 DB를 읽고/쓰도록 전환됩니다.

# 프로젝트 URL (예: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public 키 (브라우저에 노출되어도 되는 공개 키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 (서버 전용 · 절대 외부에 공개 금지)
# 보드에서 카드를 옮길 때 서버가 이 키로 DB에 저장합니다.
SUPABASE_SERVICE_ROLE_KEY=


# ── Google 연동 (캘린더 + 메일 발송) ────────────────────
# 계정을 한 번 연결하면 두 가지가 함께 켜집니다.
#   · 일정 조율 : 면접관 캘린더의 실시간 빈 시간(free-busy) 조회
#   · 메일 발송 : 후보자에게 나가는 안내·통보 메일이 이 Gmail 계정에서 나갑니다
#                (보낸 편지함에 남고, 후보자 회신도 이 메일함으로 들어옵니다)
# 채우지 않으면 일정 조율은 '수동 가용성(샘플)'로, 메일은 기록만 남습니다.
#
# 발급 방법 (설정 화면 하단 안내와 동일):
#   1) console.cloud.google.com → 프로젝트 생성 →
#      "Google Calendar API" 와 "Gmail API" 두 가지를 사용 설정
#   2) OAuth 동의 화면 구성(테스트 사용자에 회사 계정 추가)
#   3) 사용자 인증 정보 → OAuth 클라이언트 ID → 유형 "웹 애플리케이션"
#      승인된 리디렉션 URI 에 아래 GOOGLE_REDIRECT_URI 값을 등록
#   4) 아래 두 값을 채우고 서버 재시작 → 설정 화면 "Google 연결" 클릭

# OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=

# OAuth 클라이언트 보안 비밀 (서버 전용 · 절대 공개 금지)
GOOGLE_CLIENT_SECRET=

# 콜백 URL. 비워 두는 것을 권장합니다 — 비우면 아래 NEXT_PUBLIC_APP_ORIGIN
# (또는 Vercel 이 넣어 주는 배포 주소) 뒤에 /api/google/callback 을 자동으로 붙입니다.
# 여기에 값을 적으면 그 값이 무조건 우선합니다.
GOOGLE_REDIRECT_URI=

# 면접관(내부 id) → Google 캘린더(이메일) 매핑. 없으면 수동 가용성으로 폴백.
# 예: {"u1":"lead@company.com","u4":"eng2@company.com"}
GOOGLE_CALENDAR_MAP=


# ── 리마인드 실발송 (선택) ──────────────────────────────
# 채우지 않으면 리마인드는 화면에만 표시되고 실제로 나가지 않습니다.
# 하나라도 채우면 '지금 보내기' 버튼과 크론이 실제로 발송합니다.

# ⚠️ 안전장치 — 가장 먼저 채우세요.
# 이 주소가 있으면 후보자·면접관 주소를 무시하고 전부 이 주소로만 보냅니다.
# 실수로 진짜 지원자에게 메일이 나가는 사고를 막습니다.
# 실제 운영에 들어갈 때만 비우세요.
REMINDER_TEST_TO=

# 메일 발송에 보이는 보내는 사람 이름. 주소는 연결한 Gmail 계정이 됩니다.
REMINDER_FROM_NAME=TalentCore 채용팀

# 이메일 발송 대안 — Google 을 연결하지 않을 때만 씁니다.
# https://resend.com 에서 API 키 발급 (무료 플랜 가능)
RESEND_API_KEY=

# Resend 를 쓸 때의 발신 주소. 도메인 인증 전에는 기본 주소를 그대로 두세요.
REMINDER_FROM=Cadence <onboarding@resend.dev>

# Slack 발송 — Slack 앱 → Incoming Webhooks → 채널 선택 후 나오는 URL
SLACK_WEBHOOK_URL=

# (옛 이름) 앱 주소. 아래 NEXT_PUBLIC_APP_ORIGIN 하나로 통일했습니다.
# 이미 쓰고 있으면 그대로 동작하니 굳이 지울 필요는 없습니다.
NEXT_PUBLIC_BASE_URL=

# 크론(/api/cron/reminders) 보호용 비밀값. 아무 긴 문자열이나 넣으세요.
# 호출 시 헤더: Authorization: Bearer <이 값>
CRON_SECRET=


# ── TalentCore(HRIS) 연동 (선택) ────────────────────────
# 채우지 않으면 TalentCore 가 자리를 밀어 넣는 문이 닫혀 있습니다(설정 화면에 "미설정").
# 아무 긴 문자열이나 넣고, TalentCore 관리자 화면 [Hire 연동] 에 똑같은 값을 넣으세요.
CORE_INBOUND_TOKEN=


# ── TalentCore 직원 명부 당겨오기 (선택) ────────────────
# 면접관 명부를 TalentCore 에서 주기적으로 읽어옵니다(단방향 read-only).
# 채우지 않으면 면접관은 Hire 안에서 직접 등록/수정합니다.
CORE_URL=
CORE_API_TOKEN=

# 회사 이름. TalentCore 연동이 없을 때 화면에 표시할 이름입니다.
NEXT_PUBLIC_ORG_NAME=

# ── 이 앱의 바깥 주소 (링크·구글 콜백이 전부 여기서 나옵니다) ──
# 후보자에게 보내는 자리 고르기 링크, 면접관 링크, 구글 로그인이 돌아올 주소가
# 모두 이 값 기준입니다. 끝에 / 는 붙이지 마세요.
#   내 컴퓨터 : http://localhost:3000
#   배포본    : https://내-프로젝트.vercel.app  (또는 연결한 도메인)
# Vercel 에서는 비워 둬도 배포 주소로 자동 폴백하지만, 도메인을 붙였다면
# 반드시 여기에 그 도메인을 적으세요.
NEXT_PUBLIC_APP_ORIGIN=


# ── Vercel 에 올릴 때 ───────────────────────────────────
# 이 파일의 값들은 Vercel → Project → Settings → Environment Variables 에
# 같은 이름으로 넣습니다(.env.local 파일은 올라가지 않습니다).
# 반드시 넣어야 도는 것 :
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   NEXT_PUBLIC_APP_ORIGIN
# 넣지 않아도 되는 것 :
#   SUPABASE_ACCESS_TOKEN — 내 컴퓨터에서 마이그레이션 돌릴 때만 씁니다.
#                           계정 전체 권한이라 배포본에는 절대 넣지 마세요.
